# Docker Compose reads this file as .env. Every value has a local default.
JWT_SECRET=change-me
INTERNAL_SERVICE_SECRET=change-me
INTERNAL_WEBHOOK_SECRET=change-me
SEED_PASSWORD=change-me-to-12-or-more-characters

# MongoDB image tag for the local stack. MongoDB 8 does not start on Linux hosts
# with kernel 6.19 or newer; set 7.0 there.
# MONGO_VERSION=8.0
