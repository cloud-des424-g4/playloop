# Rendered to /etc/nginx/conf.d/default.conf when the container starts. Only ${API_UPSTREAM} and
# ${NGINX_LOCAL_RESOLVERS} are replaced; every other $name is an Nginx variable.

# Caddy or a load balancer may terminate TLS in front. Without one, keep the local scheme.
map $http_x_forwarded_proto $forwarded_proto {
  default $scheme;
  https https;
  http http;
}

server {
  listen 80;
  root /usr/share/nginx/html;

  # A variable in proxy_pass makes Nginx look the API up again after it restarts, and lets this
  # container start before the API does.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  # Same limit as the gateway. Files are uploaded straight to storage, not through the API.
  client_max_body_size 2m;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Vite puts a content hash in these file names, so they never change.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff;
    try_files $uri =404;
  }

  # Client-side routes such as /games/123 are served index.html, which must not be cached so a
  # new deploy is picked up.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff;
    try_files $uri /index.html;
  }
}
