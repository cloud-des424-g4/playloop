{
  "name": "playloop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "shared",
    "services/*",
    "lambdas/*"
  ],
  "scripts": {
    "seed": "docker compose run --rm identity node services/identity/scripts/seed.js && docker compose run --rm community node services/community/scripts/seed.js",
    "dev": "docker compose up --build",
    "smoke": "node services/stack-tests/smoke.js",
    "test": "npm test -w @playloop/stack-tests -w @playloop/lambda-build-unzip -w @playloop/lambda-monthly-badges",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:lint": "redocly lint playloop",
    "spec:bundle": "redocly bundle playloop",
    "services:up": "docker compose up -d --build --wait gateway",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.64.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
