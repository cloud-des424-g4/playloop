# Copy to .env.ec2 on EC2, or store the filled file as a plaintext Secrets Manager secret.
# Use single quotes for secrets/URIs so Compose does not interpolate dollar signs.
# Never commit the filled file. Do not use these placeholders as real credentials.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
CLIENT_ORIGIN=https://frontend.YOUR_APP_ID.amplifyapp.com
AWS_REGION=ap-southeast-1
LOG_LEVEL=info

JWT_SECRET='REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS'
INTERNAL_SERVICE_SECRET='REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS'
INTERNAL_WEBHOOK_SECRET='REPLACE_WITH_THE_SAME_SECRET_AS_THE_SAM_PARAMETER'

# URL-encode the Atlas username/password. These four databases share one cluster.
MONGODB_IDENTITY_URI='mongodb+srv://USER:PASSWORD@CLUSTER/playloop_identity?retryWrites=true&w=majority'
MONGODB_COMMUNITY_URI='mongodb+srv://USER:PASSWORD@CLUSTER/playloop_community?retryWrites=true&w=majority'
MONGODB_NOTIFICATIONS_URI='mongodb+srv://USER:PASSWORD@CLUSTER/playloop_notifications?retryWrites=true&w=majority'
MONGODB_MEDIA_URI='mongodb+srv://USER:PASSWORD@CLUSTER/playloop_media?retryWrites=true&w=majority'

# Copy the exact values from the SAM stack outputs.
S3_MEDIA_BUCKET=playloop-dev-media-YOUR_ACCOUNT_ID
S3_BUILDS_BUCKET=playloop-dev-builds-YOUR_ACCOUNT_ID
S3_PLAY_BUCKET=playloop-dev-play-YOUR_ACCOUNT_ID
MEDIA_CDN_URL=https://YOUR_MEDIA_DISTRIBUTION.cloudfront.net
PLAY_CDN_URL=https://YOUR_PLAY_DISTRIBUTION.cloudfront.net
BUILD_UNZIP_FUNCTION=playloop-dev-build-unzip
CLOUDWATCH_LOG_GROUP=/playloop/dev/backend
